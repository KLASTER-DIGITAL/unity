	"scripts": {
		"dev": "vite",
		"dev:ci": "vite --no-open",
		"prebuild": "node scripts/generate-sw-version.js",
		"build": "vite build",
		"build:analyze": "ANALYZE=true vite build",
		"preview": "vite preview",
		"type-check": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:unsafe": "biome check --write --unsafe .",
		"format": "biome format --write .",
		"lint:md": "markdownlint 'docs/**/*.md' --ignore docs/archive",
		"lint:md:fix": "markdownlint 'docs/**/*.md' --ignore docs/archive --fix",
		"pre-commit": "npm run type-check && npm run lint && npm run build",
		"scan:translations": "tsx scripts/scan-translation-keys.ts",
		"start:expo": "expo start",
		"start:expo:clear": "expo start --clear",
		"start:expo:web": "expo start --web",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:debug": "playwright test --debug",
		"test:e2e:chromium": "playwright test --project=chromium",
		"test:e2e:firefox": "playwright test --project=firefox",
		"test:e2e:webkit": "playwright test --project=webkit",
		"test:e2e:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
		"test:e2e:report": "playwright show-report",
		"clean": "rm -rf build dist",
		"deploy": "vercel --prod",
		"deploy:gh": "npm run build && gh-pages -d build",
		"analyze": "node scripts/analyze-bundle.js",
		"optimize:images": "node scripts/optimize-images.js",
		"optimize:images:convert": "node scripts/optimize-images.js convert",
		"i18n:generate-types": "tsx scripts/generate-translation-types.ts",
		"update:image-imports": "node scripts/update-image-imports.js",
		"lighthouse": "node scripts/lighthouse-audit.js",
		"lighthouse:url": "node scripts/lighthouse-audit.js url",
		"perf": "npm run build && npm run analyze",
		"perf:full": "npm run build && npm run analyze && npm run lighthouse",
		"monitor:queries": "tsx scripts/monitor-query-performance.ts",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"tsc --noEmit"
		]
	},
	"overrides": {
		"react": "18.3.1",
		"react-dom": "18.3.1"
	},
	"packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
